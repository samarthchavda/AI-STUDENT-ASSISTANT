# AI Student Assistant - Main .gitignore

# Environment files (IMPORTANT: Never commit these!)
.env
.env.local
.env.production
backend/.env
frontend/.env

# Python
__pycache__/
*.py[cod]
venv/
env/

# Node
node_modules/
dist/
build/

# Database
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.bak
*.backup
*_backup_*.json
*.old

# Test and check scripts
test_*.py
check_*.py
fix_*.py
verify_*.py

# Export files (keep only cleaned versions)
*_export.json
*_removed.json