# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://student_user:student_pass@localhost:5432/ai_student_db

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google OAuth (must match frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI API Keys (Only Gemini is used - Get your key from https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Payment API Keys (Demo)
STRIPE_API_KEY=sk_test_demo123456
STRIPE_WEBHOOK_SECRET=whsec_demo123
RAZORPAY_KEY_ID=rzp_test_demo123456
RAZORPAY_KEY_SECRET=demo_secret_key

# App Settings
APP_NAME=AI Student Assistant
APP_VERSION=1.0.0
