# Backend Environment Variables
# Copy this to backend/.env and fill in your values

# Code Execution Configuration
# Set USE_MOCK_EXECUTION=false to use real Judge0 execution
USE_MOCK_EXECUTION=true

# Judge0 Configuration (only needed if USE_MOCK_EXECUTION=false)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
USE_RAPIDAPI=true

# If using self-hosted Judge0, set:
# JUDGE0_API_URL=http://your-judge0-instance:2358
# USE_RAPIDAPI=false
# USE_MOCK_EXECUTION=false

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# Other backend variables
# SECRET_KEY=your_secret_key
# FRONTEND_URLS=http://localhost:3000,http://localhost:5173
