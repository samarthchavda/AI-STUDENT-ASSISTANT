# Example environment variables
# Copy this file to .env and add your actual values

# Google OAuth Client ID (get from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=your_actual_client_id_here.apps.googleusercontent.com

# Optional: comma-separated origins allowed to show Google Sign-In button
# Example: http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com
VITE_GOOGLE_AUTHORIZED_ORIGINS=

# API URL
VITE_API_URL=http://localhost:8000/api
